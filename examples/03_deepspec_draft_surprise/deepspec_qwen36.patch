+    Handles wrapper architectures (Gemma4, Qwen3.5/3.6 MoE, other
+    *ForConditionalGeneration models) whose text decoder is nested under
+    `.model`, `.language_model`, or `.model.language_model`.
+    """
+    inner = getattr(target_model, "model", None)
+    candidates = [
